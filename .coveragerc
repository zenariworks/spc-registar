[run]
# Measured from the crkva/ working dir (where manage.py test discovers tests).
source =
    registar
    kalendar
    tenants
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */__init__.py
    */apps.py

[report]
show_missing = false
skip_covered = false
# #303: спроведи минималну покривеност да не би тихо опадала.
# #414: покривеност је 90% (октобар 2026); праг 85% оставља простор за ситна
# колебања. Нов код у PR-у додатно проверава diff-cover (tests.yml).
fail_under = 85
exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
    def __repr__
